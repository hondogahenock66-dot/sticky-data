body {
    font-family: Arial;
    background: #f4f8ff;
    text-align: center;
}

.container {
    background: white;
    padding: 30px;
    margin: 100px auto;
    width: 300px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

h1 {
    color: #007BFF;
}

input, select, button {
    width: 90%;
    padding: 10px;
    margin: 10px;
}

button {
    background: #007BFF;
    color: white;
    border: none;
    cursor: pointer;
}
